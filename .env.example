# CampusPay Environment Variables Example Template

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://campuspay:campuspay123@localhost:5432/campuspay_db?schema=public"

# Session & JWT Authentication Encryption Secret
JWT_SECRET="campus-pay-super-secret-production-key-2026"
NEXTAUTH_SECRET="campus-pay-nextauth-secret-key-2026"
NEXTAUTH_URL="http://localhost:3000"

# Application Server Configuration
PORT=3000
NODE_ENV="development"
