// Prisma Schema for CampusPay v1.3 Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                     String           @id @default(uuid())
  name                   String
  email                  String           @unique
  password               String
  role                   String           @default("STUDENT") // STUDENT | ADMIN
  department             String?
  university             String?          @default("Sunamganj Science and Technology University")
  room                   String?
  phone                  String?
  balance                Float            @default(25000.0)
  preferredPaymentMethod String?          @default("BKASH")
  isVerified             Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  transactions           Transaction[]
  notifications          Notification[]
  paymentRequests        PaymentRequest[]
}

model Service {
  id                String        @id @default(uuid())
  name              String
  slug              String        @unique
  description       String
  category          String        // DEPOSIT | WITHDRAWAL | RECHARGE | TRANSFER | UTILITY
  icon              String
  baseChargeRate    Float
  estProcessingTime String        @default("Instant")
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  transactions      Transaction[]
}

model PaymentMethod {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  logo         String
  description  String
  isAvailable  Boolean       @default(true)
  estTime      String        @default("Instant")
  dailyLimit   Float         @default(25000.0)
  feeRate      Float         @default(1.85)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id              String         @id @default(uuid())
  referenceId     String         @unique @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  type            String         // CASH_IN | CASH_OUT | RECHARGE | BANK_TRANSFER | BILL_PAYMENT
  amount          Float
  chargeAmount    Float          @default(0.0)
  totalAmount     Float
  provider        String         // BKASH | NAGAD | ROCKET | CELLFIN | BANK | UPAY
  recipient       String?
  reference       String?
  status          String         @default("COMPLETED") // COMPLETED | PENDING | FAILED
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  description String
  priority    String   @default("MEDIUM") // HIGH | MEDIUM | LOW
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Settings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Admin {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          String         @default("SUPER_ADMIN")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  auditLogs     AuditLog[]
  adminComments AdminComment[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String
  target    String
  details   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentRequest {
  id             String          @id @default(uuid())
  referenceId    String          @unique
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Float
  provider       String          @default("BKASH")
  serviceType    String          @default("CASH_IN")
  merchantLink   String          @default("https://shop.bkash.com/masudul01572902196/paymentlink/default-payment")
  merchantName   String          @default("MD. MASUDUL HASAN")
  status         String          @default("PENDING") // PENDING | SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  verifications  Verification[]
  receipts       Receipt[]
  statusHistory  StatusHistory[]
  adminComments  AdminComment[]
}

model Verification {
  id               String         @id @default(uuid())
  paymentRequestId String
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  trxId            String         @unique
  senderPhone      String
  amountPaid       Float
  notes            String?
  verifiedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Receipt {
  id               String         @id @default(uuid())
  referenceId      String         @unique
  paymentRequestId String
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  amount           Float
  paymentMethod    String
  status           String
  pdfUrl           String?
  createdAt        DateTime       @default(now())
}

model StatusHistory {
  id               String         @id @default(uuid())
  paymentRequestId String
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  fromStatus       String
  toStatus         String
  remark           String?
  createdAt        DateTime       @default(now())
}

model AdminComment {
  id               String         @id @default(uuid())
  paymentRequestId String
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  adminId          String
  admin            Admin          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  comment          String
  createdAt        DateTime       @default(now())
}
