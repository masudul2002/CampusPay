// Prisma Schema for CampusPay v1.1 Student Financial Services Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                     String        @id @default(uuid())
  name                   String
  email                  String        @unique
  password               String
  role                   String        @default("STUDENT") // STUDENT | ADMIN
  department             String?
  university             String?       @default("Sunamganj Science and Technology University")
  room                   String?
  phone                  String?
  balance                Float         @default(25000.0)
  preferredPaymentMethod String?       @default("BKASH")
  isVerified             Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  transactions           Transaction[]
}

model Service {
  id                 String        @id @default(uuid())
  name               String
  slug               String        @unique
  description        String
  category           String        // DEPOSIT | WITHDRAWAL | RECHARGE | TRANSFER | UTILITY
  icon               String
  baseChargeRate     Float
  estProcessingTime  String        @default("Instant")
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  transactions       Transaction[]
}

model PaymentMethod {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  logo         String
  description  String
  isAvailable  Boolean       @default(true)
  estTime      String        @default("Instant")
  dailyLimit   Float         @default(25000.0)
  feeRate      Float         @default(1.85)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id              String         @id @default(uuid())
  referenceId     String         @unique @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  type            String         // CASH_IN | CASH_OUT | RECHARGE | BANK_TRANSFER | BILL_PAYMENT
  amount          Float
  chargeAmount    Float          @default(0.0)
  totalAmount     Float
  provider        String         // BKASH | NAGAD | ROCKET | CELLFIN | BANK | UPAY
  recipient       String?
  reference       String?
  status          String         @default("COMPLETED") // COMPLETED | PENDING | FAILED
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  description String
  priority    String   @default("MEDIUM") // HIGH | MEDIUM | LOW
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Settings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Admin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("SUPER_ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
